{
  "name": "nawyorders-pwa",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "cross-env TZ=Africa/Cairo VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest run",
    "test:watch": "cross-env TZ=Africa/Cairo VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest",
    "test:cov": "cross-env TZ=Africa/Cairo VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest run --coverage",
    "test:mut": "stryker run",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --project=visual",
    "test:a11y": "playwright test --grep @a11y",
    "test:all": "npm run lint && npx tsc --noEmit && npm run test:cov && npm run build"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "^16.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@next/bundle-analyzer": "^16.4.2",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.4.19",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.0",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.3",
    "lighthouse": "^13.5.0",
    "lint-staged": "^17.6.0",
    "msw": "^3.0.3",
    "postcss": "^8.4.39",
    "puppeteer-core": "^25.15.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5",
    "vitest-axe": "^0.1.0",
    "zod": "^4.6.6"
  }
}
